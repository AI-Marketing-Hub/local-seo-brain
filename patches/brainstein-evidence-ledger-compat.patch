@@ -675,0 +701,3 @@ def _check_sanitized_publish_surface(repo: Path) -> tuple[bool, str]:
+    private_surfaces = declared_private_publish_surfaces(repo)
+    if private_surfaces:
+        return True, f"private publish surface declared ({', '.join(private_surfaces)}); public site not required"
@@ -946,4 +974,6 @@ def _check_sources_pack_present(repo: Path) -> tuple[bool, str]:
