+        claims = source_claims(source)
@@ -1402 +1433 @@ def check_source_ledger(repo: Path, *, requires_fresh: bool) -> tuple[bool, int,
-        if source_type not in PRIMARY_SOURCE_TYPES and source_type not in {"market", "practitioner", "supporting", "fixture"}:
+        if source_type not in SUPPORTED_SOURCE_TYPES:
@@ -1404 +1435 @@ def check_source_ledger(repo: Path, *, requires_fresh: bool) -> tuple[bool, int,
-        if source_type in PRIMARY_SOURCE_TYPES:
+        if is_primary_source(source):
@@ -1411,2 +1442,4 @@ def check_source_ledger(repo: Path, *, requires_fresh: bool) -> tuple[bool, int,
-        if not isinstance(claims, list) or not any(clean_string(claim) for claim in claims):
-            critical.append(f"{label} must list sourced claims")
+        if not isinstance(claims, list):
+            critical.append(f"{label} must include a claims or supports_claims list")
+        else:
+            mapped_claim_count += sum(1 for claim in claims if clean_string(claim))
@@ -1422,0 +1456,2 @@ def check_source_ledger(repo: Path, *, requires_fresh: bool) -> tuple[bool, int,
+    if mapped_claim_count == 0:
+        critical.append("source-ledger must map at least one sourced claim")
@@ -1784,0 +1820,28 @@ def clean_string(value: object) -> str:
+def source_claims(source: dict[str, Any]) -> object:
+    if isinstance(source.get("claims"), list):
+        return source["claims"]
+    return source.get("supports_claims")
+
+
+def is_primary_source(source: dict[str, Any]) -> bool:
+    source_type = clean_string(source.get("source_type")).lower()
+    authority = clean_string(source.get("authority")).lower()
+    return source_type in PRIMARY_SOURCE_TYPES or authority in PRIMARY_SOURCE_AUTHORITIES
+
+
+def declared_private_publish_surfaces(repo: Path) -> list[str]:
+    surfaces: list[str] = []
+    specs_dir = repo / "specs"
+    paths = sorted(specs_dir.glob("*.yaml")) if specs_dir.is_dir() else []
+    for path in paths:
+        try:
+            surface = load_spec(path).publish_surface.strip().lower()
+        except (OSError, ValueError):
+            return []
+        if surface.startswith("private-") or surface in {"none", "disabled", "repository-only", "source-only"}:
+            surfaces.append(surface)
+        else:
+            return []
+    return surfaces
+
+
